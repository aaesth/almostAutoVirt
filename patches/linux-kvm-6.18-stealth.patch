+static int kvm_modrm_extra_len(u8 modrm, const u8 *rest, int max_rest)
+{
+	u8 mod = (modrm >> 6) & 3;
+	u8 rm = modrm & 7;
+	int extra = 0;
+
+	if (mod == 3)
+		return 0;
+	if (rm == 4) {
+		if (max_rest < 1)
+			return -1;
+		extra++;
+		if (mod == 0 && (rest[0] & 7) == 5)
+			extra += 4;
+	}
+	if (mod == 0 && rm == 5)
+		extra += 4;
+	else if (mod == 1)
+		extra += 1;
+	else if (mod == 2)
+		extra += 4;
+
+	if (extra > max_rest)
+		return -1;
+	return extra;
+}
+
+static int kvm_parse_mov_r64_mem(const u8 *buf, int pos, int limit,
+				 int *reg_out, u8 *mem_sig, int *sig_len)
+{
+	u8 rex, op, modrm;
+	int extra, len;
+
+	if (pos + 3 > limit)
+		return 0;
+	rex = buf[pos];
+	op = buf[pos + 1];
+	modrm = buf[pos + 2];
+	if ((rex & 0xf8) != 0x48 || op != 0x8b)
+		return 0;
+	if (((modrm >> 6) & 3) == 3)
+		return 0;
+
+	extra = kvm_modrm_extra_len(modrm, &buf[pos + 3], limit - (pos + 3));
+	if (extra < 0)
+		return 0;
+	len = 3 + extra;
+
+	*reg_out = ((modrm >> 3) & 7) | ((rex & 4) ? 8 : 0);
+	mem_sig[0] = rex & 3;
+	mem_sig[1] = modrm & 0xc7;
+	if (extra > 0)
+		memcpy(&mem_sig[2], &buf[pos + 3], extra);
+	*sig_len = 2 + extra;
+	return len;
+}
+
+static bool kvm_mem_sig_equal(int p, int pre_len, const u8 *pre_sig, int pre_sig_len,
+			      int q, int post_len, const u8 *post_sig, int post_sig_len)
+{
+	if (pre_sig_len != post_sig_len)
+		return false;
+	if (pre_sig[0] == 0 && post_sig[0] == 0 &&
+	    pre_sig[1] == 0x05 && post_sig[1] == 0x05 && pre_sig_len == 6) {
+		s32 pre_disp, post_disp;
+
+		memcpy(&pre_disp, &pre_sig[2], 4);
+		memcpy(&post_disp, &post_sig[2], 4);
+		return (p + pre_len + pre_disp) == (q + post_len + post_disp);
+	}
+	return memcmp(pre_sig, post_sig, pre_sig_len) == 0;
+}
+
+static void kvm_compensate_cpuid_timer(struct kvm_vcpu *vcpu, u64 rip, u64 orig_rbx)
+{
+	u8 buf[64];
+	struct x86_exception e;
+	int p;
+
+	if (rip < 24)
+		return;
+	if (kvm_read_guest_virt(vcpu, rip - 24, buf, sizeof(buf), &e) != X86EMUL_CONTINUE)
+		return;
+	if (buf[24] != 0x0f || buf[25] != 0xa2)
+		return;
+
+	for (p = 21; p >= 6; p--) {
+		int pre_reg = -1, pre_sig_len = 0;
+		u8 pre_sig[12];
+		int pre_len = kvm_parse_mov_r64_mem(buf, p, 24, &pre_reg, pre_sig, &pre_sig_len);
+		int q = 26;
+		bool need_pop_rbx = false;
+		bool need_restore_rbx = false;
+
+		if (pre_len <= 0)
+			continue;
+
+		while (q < 56) {
+			int post_reg = -1, post_sig_len = 0;
+			u8 post_sig[12];
+			int post_len = kvm_parse_mov_r64_mem(buf, q, 64, &post_reg, post_sig, &post_sig_len);
+
+			if (post_len > 0 &&
+			    kvm_mem_sig_equal(p, pre_len, pre_sig, pre_sig_len,
+					      q, post_len, post_sig, post_sig_len)) {
+				u64 v_pre, ref_delta = 3;
+				u64 c0 = ~0ULL, c1 = ~0ULL;
+				int r;
+
+				if (pre_reg == VCPU_REGS_RBX)
+					v_pre = orig_rbx;
+				else
+					v_pre = kvm_register_read_raw(vcpu, pre_reg);
+
+				if (v_pre > 2000) {
+					for (r = 0; r < 16; r++) {
+						u64 val;
+
+						if (r == VCPU_REGS_RAX || r == VCPU_REGS_RCX ||
+						    r == VCPU_REGS_RDX || r == VCPU_REGS_RSP ||
+						    r == pre_reg)
+							continue;
+						val = (r == VCPU_REGS_RBX) ?
+						      orig_rbx : kvm_register_read_raw(vcpu, r);
+						if (val < v_pre && (v_pre - val) < 500) {
+							if (val < c0) {
+								c1 = c0;
+								c0 = val;
+							} else if (val > c0 && val < c1) {
+								c1 = val;
+							}
+						}
+					}
+					if (c0 != ~0ULL && c1 != ~0ULL && c1 > c0) {
+						ref_delta = c1 - c0;
+						if (ref_delta < 2)
+							ref_delta = 2;
+						else if (ref_delta > 40)
+							ref_delta = 40;
+					}
+				}
+
+				if (need_pop_rbx) {
+					u64 rsp = kvm_rsp_read(vcpu);
+					u64 popped_rbx = orig_rbx;
+
+					if (kvm_read_guest_virt(vcpu, rsp, &popped_rbx, 8, &e) == X86EMUL_CONTINUE)
+						kvm_rbx_write(vcpu, popped_rbx);
+					else
+						kvm_rbx_write(vcpu, orig_rbx);
+					kvm_rsp_write(vcpu, rsp + 8);
+				} else if (need_restore_rbx) {
+					kvm_rbx_write(vcpu, orig_rbx);
+				}
+
+				kvm_register_write_raw(vcpu, post_reg, v_pre + ref_delta);
+				kvm_rip_write(vcpu, rip + (q - 24) + post_len);
+				pr_info_once("kvm: compensated VM::timer cpuid at rip=0x%llx pre_reg=%d post_reg=%d v_pre=%llu ref_delta=%llu\n",
+					     rip, pre_reg, post_reg, v_pre, ref_delta);
+				return;
+			}
+
+			if (buf[q] == 0x5b) {
+				need_pop_rbx = true;
+				q += 1;
+			} else if (buf[q] == 0x90) {
+				q += 1;
+			} else if (buf[q] == 0x89 ||
+				   ((buf[q] & 0xf0) == 0x40 && q + 1 < 64 && buf[q + 1] == 0x89)) {
+				int has_rex = ((buf[q] & 0xf0) == 0x40) ? 1 : 0;
+				u8 rex = has_rex ? buf[q] : 0;
+				u8 modrm;
+				int extra;
+
+				if (q + has_rex + 2 > 64)
+					break;
+				modrm = buf[q + has_rex + 1];
+				extra = kvm_modrm_extra_len(modrm, &buf[q + has_rex + 2],
+							    64 - (q + has_rex + 2));
+				if (extra < 0)
+					break;
+				if (((modrm >> 6) & 3) == 3) {
+					int dst = (modrm & 7) | ((rex & 1) ? 8 : 0);
+
+					if (dst == VCPU_REGS_RBX)
+						need_restore_rbx = true;
+				}
+				q += has_rex + 2 + extra;
+			} else if ((buf[q] & 0xf8) == 0x48 && q + 3 <= 64 &&
+				   (buf[q + 1] == 0x8b || buf[q + 1] == 0x87) &&
+				   (((buf[q + 2] >> 6) & 3) == 3)) {
+				u8 rex = buf[q];
+				u8 modrm = buf[q + 2];
+				int reg1 = ((modrm >> 3) & 7) | ((rex & 4) ? 8 : 0);
+				int reg2 = (modrm & 7) | ((rex & 1) ? 8 : 0);
+
+				if (reg1 == VCPU_REGS_RBX ||
+				    (buf[q + 1] == 0x87 && reg2 == VCPU_REGS_RBX))
+					need_restore_rbx = true;
+				q += 3;
+			} else {
+				break;
+			}
+		}
+	}
+}
+
 int kvm_emulate_cpuid(struct kvm_vcpu *vcpu)
 {
 	u32 eax, ebx, ecx, edx;
+	u64 orig_eax, orig_rbx, orig_rip;
+	int ret;
 
 	if (cpuid_fault_enabled(vcpu) && !kvm_require_cpl(vcpu, 0))
 		return 1;
 
-	eax = kvm_rax_read(vcpu);
+	orig_eax = kvm_rax_read(vcpu);
+	orig_rbx = kvm_rbx_read(vcpu);
+	orig_rip = kvm_rip_read(vcpu);
+
+	eax = (u32)orig_eax;
 	ecx = kvm_rcx_read(vcpu);
 	kvm_cpuid(vcpu, &eax, &ebx, &ecx, &edx, false);
 	kvm_rax_write(vcpu, eax);
 	kvm_rbx_write(vcpu, ebx);
 	kvm_rcx_write(vcpu, ecx);
 	kvm_rdx_write(vcpu, edx);
-	return kvm_skip_emulated_instruction(vcpu);
+
+	ret = kvm_skip_emulated_instruction(vcpu);
+	if (ret == 1 && (u32)orig_eax == 0 && is_64_bit_mode(vcpu) &&
+	    kvm_x86_call(get_cpl)(vcpu) > 0 &&
+	    !(kvm_x86_call(get_rflags)(vcpu) & X86_EFLAGS_TF))
+		kvm_compensate_cpuid_timer(vcpu, orig_rip, orig_rbx);
+
+	return ret;
 }
 EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_emulate_cpuid);
