diff --git a/backends/tpm/tpm_emulator.c b/backends/tpm/tpm_emulator.c
index 75c33d2..d88a22e 100644
--- a/backends/tpm/tpm_emulator.c
+++ b/backends/tpm/tpm_emulator.c
@@ -206,6 +206,67 @@ static int tpm_emulator_unix_tx_bufs(TPMEmulator *tpm_emu,
         *selftest_done = tpm_cmd_get_errcode(out) == 0;
     }
 
+    /*
+     * Spoof TPM2_GetCapability (0x0000017A) responses so swtpm/libtpms looks
+     * like Intel PTT (INTC) and does not match the libtpms algorithm profile.
+     */
+    if (in_len >= 22 && tpm_cmd_get_size(out) >= 19 &&
+        tpm_cmd_get_errcode(out) == 0 &&
+        ldl_be_p(in + 6) == 0x0000017AU) {
+        uint32_t cap = ldl_be_p(in + 10);
+        uint32_t rsp_size = tpm_cmd_get_size(out);
+        uint32_t rsp_cap = ldl_be_p(out + 11);
+        uint32_t count = ldl_be_p(out + 15);
+
+        if (cap == 0x00000000U && rsp_cap == 0x00000000U &&
+            19U + count * 6U <= rsp_size) {
+            uint8_t *p = out + 19;
+            for (uint32_t i = 0; i < count; i++) {
+                uint16_t alg_id = lduw_be_p(p + i * 6U);
+                if (alg_id == 0x0026U /* TPM_ALG_CAMELLIA */) {
+                    uint32_t rem = (count - 1U - i) * 6U;
+                    if (rem > 0) {
+                        memmove(p + i * 6U, p + (i + 1U) * 6U, rem);
+                    }
+                    count--;
+                    rsp_size -= 6U;
+                    stl_be_p(out + 2, rsp_size);
+                    stl_be_p(out + 15, count);
+                    break;
+                }
+            }
+        } else if (cap == 0x00000006U && rsp_cap == 0x00000006U &&
+                   19U + count * 8U <= rsp_size) {
+            uint8_t *p = out + 19;
+            for (uint32_t i = 0; i < count; i++) {
+                uint32_t prop = ldl_be_p(p + i * 8U);
+                uint8_t *val_p = p + i * 8U + 4U;
+                switch (prop) {
+                case 0x00000105U: /* TPM_PT_MANUFACTURER = "INTC" */
+                    stl_be_p(val_p, 0x494E5443U);
+                    break;
+                case 0x00000106U: /* TPM_PT_VENDOR_STRING_1 = "Inte" */
+                    stl_be_p(val_p, 0x496E7465U);
+                    break;
+                case 0x00000107U: /* TPM_PT_VENDOR_STRING_2 = "l\0\0\0" */
+                    stl_be_p(val_p, 0x6C000000U);
+                    break;
+                case 0x00000108U: /* TPM_PT_VENDOR_STRING_3 */
+                case 0x00000109U: /* TPM_PT_VENDOR_STRING_4 */
+                case 0x0000010AU: /* TPM_PT_VENDOR_TPM_TYPE */
+                case 0x0000010CU: /* TPM_PT_FIRMWARE_VERSION_2 */
+                    stl_be_p(val_p, 0x00000000U);
+                    break;
+                case 0x0000010BU: /* TPM_PT_FIRMWARE_VERSION_1 = 600.18 */
+                    stl_be_p(val_p, 0x02580012U);
+                    break;
+                default:
+                    break;
+                }
+            }
+        }
+    }
+
     return 0;
 }
 
